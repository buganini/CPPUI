# Add the symbols used by shared cookbook text to both desktop font sizes.
# Keep the SDK and its ASCII/icon glyphs unchanged; compile copies with fallbacks.
function(cppui_lvgl_symbol_fonts target)
    get_target_property(sources ${target} SOURCES)
    foreach(size 14 28)
        set(name "lv_font_montserrat_${size}.c")
        set(source "")
        foreach(candidate IN LISTS sources)
            get_filename_component(candidate_name "${candidate}" NAME)
            if(candidate_name STREQUAL name)
                set(source "${candidate}")
            endif()
        endforeach()
        if(NOT source)
            message(FATAL_ERROR "Cannot find LVGL font source ${name}")
        endif()
        file(READ "${source}" code)
        string(FIND "${code}" ".fallback = NULL," position)
        if(position EQUAL -1)
            message(FATAL_ERROR "CPPUI symbol fonts expect LVGL 9.6; review ${name} before updating the SDK")
        endif()
        string(REPLACE ".fallback = NULL," ".fallback = &cppui_font_symbols_${size}," code "${code}")
        set(patched "${CMAKE_CURRENT_BINARY_DIR}/cppui_${name}")
        file(WRITE "${patched}" "#include \"lvgl.h\"\nLV_FONT_DECLARE(cppui_font_symbols_${size})\n${code}")
        list(REMOVE_ITEM sources "${source}")
        list(APPEND sources "${patched}"
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../cppui/lvgl/fonts/cppui_font_symbols_${size}.c")
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
endfunction()
