include_guard(GLOBAL)

function(cppui_add_lvgl_desktop driver)
    if(NOT driver MATCHES "^lvgl_(sdl2|x11)$")
        message(FATAL_ERROR "Unknown LVGL desktop driver: ${driver}")
    endif()
    set(CPPUI_LVGL_SOURCE_DIR "" CACHE PATH "LVGL v9.6.0 source checkout")
    if(NOT EXISTS "${CPPUI_LVGL_SOURCE_DIR}/lvgl.h")
        message(FATAL_ERROR "Set CPPUI_LVGL_SOURCE_DIR to an LVGL 9.6.0 source checkout")
    endif()
    set(cppui_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    set(LV_BUILD_CONF_PATH "${cppui_root}/cppui/lvgl/desktop_conf.h" CACHE PATH "" FORCE)
    set(CONFIG_LV_BUILD_DEMOS OFF CACHE BOOL "" FORCE)
    set(CONFIG_LV_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(CONFIG_LV_USE_THORVG_INTERNAL OFF CACHE BOOL "" FORCE)
    set(LV_FETCH_DEPENDENCIES OFF CACHE BOOL "" FORCE)
    add_subdirectory("${CPPUI_LVGL_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/lvgl")
    target_compile_definitions(lvgl PUBLIC
        CPPUI_LVGL_SDL2=$<STREQUAL:${driver},lvgl_sdl2>
        CPPUI_LVGL_X11=$<STREQUAL:${driver},lvgl_x11>)
    if(driver STREQUAL "lvgl_sdl2")
        find_package(SDL2 REQUIRED CONFIG)
        target_link_libraries(lvgl PUBLIC SDL2::SDL2)
    else()
        find_package(X11 REQUIRED)
        find_package(Threads REQUIRED)
        target_link_libraries(lvgl PUBLIC X11::X11 Threads::Threads)
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CPPUILVGLX11.cmake")
    endif()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CPPUILVGLInput.cmake")
    cppui_lvgl_input_bridge(lvgl "${CPPUI_LVGL_SOURCE_DIR}")
    if(UNIX)
        target_link_libraries(lvgl PUBLIC m)
    endif()
    add_library(cppui_lvgl INTERFACE)
    add_library(CPPUI::lvgl ALIAS cppui_lvgl)
    target_include_directories(cppui_lvgl INTERFACE "${cppui_root}")
    target_compile_definitions(cppui_lvgl INTERFACE CPPUI_BACKEND_LVGL=1)
    target_compile_features(cppui_lvgl INTERFACE cxx_std_11)
    target_link_libraries(cppui_lvgl INTERFACE lvgl::lvgl)
endfunction()
