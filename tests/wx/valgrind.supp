# Reproduced by tests/wx_native_baseline.cpp with wxGTK 3.2.9 / GTK 3.24.
# Only reproduced toolkit allocations; no CPPUI or wx object allocations.
{
   wxgtk-fontconfig-cache
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:*alloc
   obj:*/libfontconfig.so.*
}
{
   wxgtk-fontconfig-values
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   fun:malloc
   fun:strdup
   obj:*/libfontconfig.so.*
}
{
   wxgtk-pango-language
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   fun:g_malloc0
   fun:pango_language_from_string
   fun:pango_language_get_default
}
{
   wxgtk-pango-font-cache
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   fun:g_malloc0
   fun:g_atomic_rc_box_alloc0
   obj:*/libpangoft2-1.0.so.*
}
{
   wxgtk-theme-state
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:g_malloc
   fun:g_memdup
   obj:*/libgtk-3.so.*
   fun:gtk_style_context_set_state
}
{
   wxgtk-theme-classes
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:g_malloc
   obj:*/libgtk-3.so.*
   obj:*/libgtk-3.so.*
   fun:gtk_style_context_add_class
}
{
   wxgtk-worker-tls
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   ...
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create*
   obj:*/libglib-2.0.so.*
   fun:g_thread_*
}
# Native checkbox/radio theme images leave Rust interior pointers in Glycin's
# process worker pool. Reproduced by the native-only control baseline.
{
   wxgtk-glycin-workers
   Memcheck:Leak
   match-leak-kinds: possible
   fun:*alloc
   obj:*/libglycin-*.so.*
}
{
   wxgtk-glycin-worker-tls
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   ...
   fun:_dl_allocate_tls
   ...
   fun:pthread_create*
   obj:*/libglycin-*.so.*
}
{
   wxgtk-glib-worker-tls
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   ...
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create*
   obj:*/libglib-2.0.so.*
   obj:*/libglib-2.0.so.*
   obj:*/libglib-2.0.so.*
   fun:start_thread
}
{
   wxgtk-glycin-aligned-workers
   Memcheck:Leak
   match-leak-kinds: possible
   fun:posix_memalign
   obj:*/libglycin-*.so.*
}
# wxRB_SINGLE creates GTK radio-group weak-notification metadata. The plain
# native baseline reproduces 32 + 56 possibly-lost bytes per standalone radio.
# Include deeper callers so this never suppresses unrelated GObject weak refs.
{
   wxgtk-single-radio-weak-notifications
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   fun:g_malloc
   ...
   fun:g_object_weak_ref
   ...
   fun:gtk_radio_button_new
   fun:_ZN13wxRadioButton6Create*
}
