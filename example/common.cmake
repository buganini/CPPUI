include(CTest)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/CPPUItesting.cmake")

function(cppui_add_example target example backend toolkit test_name)
    if(NOT backend MATCHES "^(qt|wx|lvgl)$")
        message(FATAL_ERROR "Unknown example backend: ${backend}")
    endif()
    set(example_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    string(TOUPPER "${backend}" backend_macro)
    add_library(${target}_config INTERFACE)
    target_include_directories(${target}_config INTERFACE "${example_dir}/..")
    target_compile_definitions(${target}_config INTERFACE CPPUI_BACKEND_${backend_macro}=1)
    target_compile_features(${target}_config INTERFACE cxx_std_11)
    target_link_libraries(${target}_config INTERFACE ${toolkit})
    add_executable(${target} "${example_dir}/${example}.cpp")
    target_link_libraries(${target} PRIVATE ${target}_config)
    set_target_properties(${target} PROPERTIES CXX_STANDARD 11 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
    if(BUILD_TESTING)
        add_executable(${target}_smoke "${example_dir}/../tests/examples/${example}.cpp"
            "${example_dir}/../tests/examples/${backend}.cpp")
        target_link_libraries(${target}_smoke PRIVATE ${target}_config)
        set_target_properties(${target}_smoke PROPERTIES CXX_STANDARD 11 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
        cppui_add_test(${test_name} ${target}_smoke)
        if(ARGC GREATER 5 AND ARGV5 STREQUAL "lvgl_sdl2")
            set_property(TEST ${test_name} APPEND PROPERTY ENVIRONMENT
                "SDL_VIDEODRIVER=dummy" "SDL_AUDIODRIVER=dummy" "SDL_RENDER_DRIVER=software")
            if(CPPUI_VALGRIND_TESTS)
                set_property(TEST valgrind.${test_name} APPEND PROPERTY ENVIRONMENT
                    "SDL_VIDEODRIVER=dummy" "SDL_AUDIODRIVER=dummy" "SDL_RENDER_DRIVER=software")
            endif()
        endif()
    endif()
endfunction()
