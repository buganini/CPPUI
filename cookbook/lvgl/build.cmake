    cppui_add_test(lvgl.checkbox cppui_lvgl_checkbox)

    add_executable(cppui_lvgl_radiobutton "${cppui_lvgl_dir}/../../tests/lvgl_radiobutton.cpp")
    target_include_directories(cppui_lvgl_radiobutton PRIVATE "${cppui_lvgl_dir}/../..")
    target_link_libraries(cppui_lvgl_radiobutton PRIVATE lvgl::lvgl)
    set_target_properties(cppui_lvgl_radiobutton PROPERTIES
        CXX_STANDARD 11 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
    cppui_add_test(lvgl.radiobutton cppui_lvgl_radiobutton)

    foreach(component progressbar timeline views textfield canvas_input combobox stack grid image table table_adapter)
        add_executable(cppui_lvgl_${component} "${cppui_lvgl_dir}/../../tests/lvgl_${component}.cpp")
        target_include_directories(cppui_lvgl_${component} PRIVATE "${cppui_lvgl_dir}/../..")
        target_link_libraries(cppui_lvgl_${component} PRIVATE lvgl::lvgl)
        set_target_properties(cppui_lvgl_${component} PROPERTIES
            CXX_STANDARD 11 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
        cppui_add_test(lvgl.${component} cppui_lvgl_${component})
    endforeach()
    target_compile_definitions(cppui_lvgl_image PRIVATE CPPUI_TEST_ASSET_DIR="${cppui_lvgl_dir}/../assets")

    if(CPPUI_LVGL_DRIVER STREQUAL "lvgl_sdl2")
        set_property(TEST cookbook.lvgl_sdl2 APPEND PROPERTY ENVIRONMENT
            "SDL_VIDEODRIVER=dummy" "SDL_AUDIODRIVER=dummy" "SDL_RENDER_DRIVER=software")
        if(CPPUI_VALGRIND_TESTS)
            set_property(TEST valgrind.cookbook.lvgl_sdl2 APPEND PROPERTY ENVIRONMENT
                "SDL_VIDEODRIVER=dummy" "SDL_AUDIODRIVER=dummy" "SDL_RENDER_DRIVER=software")
        endif()
    endif()

    foreach(header application runtime base button canvas checkbox combobox divider grid image label layout progressbar radiobutton scroll spacer stack tab table text textfield timeline views window)
        set(source "${CMAKE_CURRENT_BINARY_DIR}/header_lvgl_${header}.cpp")
        file(WRITE "${source}"
            "#include \"cppui/lvgl/${header}.hpp\"\n#include \"cppui/lvgl/${header}.hpp\"\n")
        add_library(cppui_header_lvgl_${header} OBJECT "${source}")
        target_include_directories(cppui_header_lvgl_${header} PRIVATE "${cppui_lvgl_dir}/../..")
        target_link_libraries(cppui_header_lvgl_${header} PRIVATE lvgl::lvgl)
    endforeach()
endif()
